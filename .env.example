# amazon-mcp has NO credentials — it is a keyless scraper. Everything below is
# optional tuning; the defaults are what the container ships with.

# Transport: "http" (default, streamable-HTTP on :8000/mcp) or "stdio".
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp

# Log level.
# LOG_LEVEL=INFO

# Scraper tuning. One long-lived Chromium context (a browser profile that
# keeps consent/session cookies) is shared by all fetches; pages are created
# per fetch and bounded by AMZ_MAX_CONCURRENT, with navigation starts spaced
# by the pacing knobs below.
# AMZ_MAX_CONTEXTS=4
# AMZ_MAX_CONCURRENT=2
# AMZ_NAV_TIMEOUT_MS=45000

# Pacing and backoff (seconds): navigation starts are spaced by a jittered
# delay; a bot challenge, 429 or page mismatch stretches the spacing with
# bounded exponential backoff, honouring Retry-After up to its own cap.
# AMZ_PACING_MIN_S=1.5
# AMZ_PACING_MAX_S=4.0
# AMZ_BACKOFF_BASE_S=2.0
# AMZ_BACKOFF_MAX_S=120.0
# AMZ_RETRY_AFTER_MAX_S=180.0

# Optional: override the User-Agent Chromium presents to amazon.de. By default
# the real Chromium identity stands (no pinned UA that drifts stale).
# AMZ_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36
