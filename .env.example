# amazon-mcp has NO credentials — it is a keyless scraper. Everything below is
# optional tuning; the defaults are what the container ships with.

# Transport: "http" (default, streamable-HTTP on :8000/mcp) or "stdio".
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp

# Log level.
# LOG_LEVEL=INFO

# Scraper tuning. Each Chromium context is a browser profile and the main
# memory cost; a chat agent scrapes one request at a time, so keep these low.
# AMZ_MAX_CONTEXTS=4
# AMZ_MAX_CONCURRENT=2
# AMZ_NAV_TIMEOUT_MS=45000

# Override the desktop User-Agent Chromium presents to amazon.de.
# AMZ_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
