# amazon-mcp has NO credentials — it is a keyless scraper. Everything below is
# optional tuning; the defaults are what the container ships with.

# Transport: "http" (default, streamable-HTTP on :8000/mcp) or "stdio".
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp

# Log level.
# LOG_LEVEL=INFO

# One shared curl_cffi Chrome-profile HTTP session retains cookies/connections.
# AMZ_MAX_CONCURRENT limits requests and connection-pool handles directly.
# AMZ_MAX_CONTEXTS was removed; AMZ_NAV_TIMEOUT_MS became AMZ_REQUEST_TIMEOUT_MS.
# The request wall budget starts after the concurrency/pacing queues.
# AMZ_MAX_CONCURRENT=2
# AMZ_REQUEST_TIMEOUT_MS=45000

# Pacing and backoff (seconds): request starts are spaced by a jittered
# delay; a bot challenge, 429 or page mismatch stretches the spacing with
# bounded exponential backoff, honouring Retry-After up to its own cap.
# AMZ_PACING_MIN_S=1.5
# AMZ_PACING_MAX_S=4.0
# AMZ_BACKOFF_BASE_S=2.0
# AMZ_BACKOFF_MAX_S=120.0
# AMZ_RETRY_AFTER_MAX_S=180.0

# Optional: override the Chrome HTTP profile's User-Agent. German
# Accept-Language remains explicit. Leave unset for the profile's default UA.
# AMZ_USER_AGENT=
